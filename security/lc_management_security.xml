<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_lc_management" model="ir.module.category">
        <field name="name">LC Management</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_lc_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="lc_management.module_category_lc_management"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_lc_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="lc_management.module_category_lc_management"/>
        <field name="implied_ids" eval="[(4, ref('lc_management.group_lc_user'))]"/>
    </record>
</odoo>
