<odoo>
    <!-- Main Tree View -->
    <record id="view_lc_management_list" model="ir.ui.view">
        <field name="name">lc.management.list</field>
        <field name="model">lc.management</field>
        <field name="arch" type="xml">
            <list string="Letters of Credit">
                <field name="priority" optional="show" widget="priority" nolabel="1"/>
                <field name="lc_number"/>
                <field name="applicant_id"/>
                <field name="beneficiary_id"/>
                <field name="issuing_bank_id"/>
                <field name="advising_bank_id"/>
                <field name="amount"/>
                <field name="currency_id"/>
                <field name="status"/>
                <field name="expiration_date"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_lc_management_form" model="ir.ui.view">
        <field name="name">lc.management.form</field>
        <field name="model">lc.management</field>
        <field name="arch" type="xml">
            <form string="Letter of Credit" create="true" edit="true">
                <header>
                    <button name="action_split_additional_cost"
                            type="object"
                            string="Split"
                            class="oe_highlight"
                            invisible="not can_split_cost"/>

                    <field name="status" widget="statusbar" options="{'clickable': '1'}"/>

                    <!-- Buttons for workflow -->
                    <button name="action_submit" string="Submit" type="object"
                            class="oe_highlight" invisible="status != 'draft'"/>

                    <button name="action_approve" string="Approve" type="object"
                            class="oe_highlight" invisible="status != 'submitted'"
                            groups="lc_management.group_lc_manager"/>

                    <button name="action_advise" string="Advise" type="object"
                            class="oe_highlight" invisible="status != 'approved'"/>

                    <button name="action_active" string="Active" type="object"
                            class="oe_highlight" invisible="status != 'advised'"/>

                    <button name="action_amend" string="Amend" type="object"
                            invisible="status not in ['approved', 'advised',]"/>

                    <button name="action_close" string="Close LC" type="object"
                            invisible="status not in ['amend', 'active']"/>

                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="status not in ['submitted', 'approved', 'advised', 'active', 'amend']"
                            groups="lc_management.group_lc_manager"/>

                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="status not in ['cancelled']"/>

                </header>

                <sheet>
                    <!-- SMART BUTTONS -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_attachments"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-paperclip"
                                invisible="attachment_count == 0">
                            <field name="attachment_count"
                                   widget="statinfo"
                                   string="Attachments"/>
                        </button>

                        <button name="action_view_po_cost_lines"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-table"
                                invisible="po_cost_line_count == 0">
                            <field name="po_cost_line_count"
                                   widget="statinfo"
                                   string="PO Split"/>
                        </button>

                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart"
                                invisible="po_count == 0">
                            <field name="po_count" widget="statinfo" string="Purchases"/>
                        </button>
                    </div>

                    <!--TITLE-->
                    <div class="oe_title">
                        <span class="o_form_label">LC Number</span>
                        <h1 class="d-flex">
                            <field name="priority" widget="priority" class="me-3"/>
                            <field name="lc_number" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="lc_type"/>
                            <field name="issuing_bank_id"/>
                            <field name="advising_bank_id"/>
                            <field name="status"/>
                            <label
                                        for="purchase_order_ids"
                                        id="purchase_order_ids_label"
                                    />
                            <div>
                                <field name="purchase_order_ids"
                                       widget="many2many_tags"
                                       domain="[
                                            ('id', 'not in', blocked_purchase_order_ids),
                                           ('state', '=', 'purchase'),
                                           '|',
                                           ('partner_id', '=', beneficiary_company_id),
                                           ('partner_id.parent_id', '=', beneficiary_company_id)
                                       ]"/>
                                <button name="action_compute_po_amount"
                                        type="object"
                                        string="Compute from POs"
                                        help="Compute LC Amount based on selected Purchase Orders."
                                        class="oe_link pt-2"
                                        invisible="status not in ('draft','submitted') or is_outdated_po"/>
                                <field name="is_outdated_po" invisible="1"/>

                                <button name="action_update_from_po"
                                        type="object"
                                        string="Update &amp; Recompute"
                                        class="btn btn-danger mt-2"
                                        invisible="status not in ('draft','submitted') or not is_outdated_po"/>

                            </div>
                            <field name="lc_template_id"/>

                        </group>
                        <group>
                            <field name="applicant_company_id"/>
                            <field name="applicant_id"/>
                            <field name="beneficiary_company_id"/>
                            <field name="beneficiary_id"
                                   context="{'default_parent_id': beneficiary_company_id, 'default_is_company': False}"
                                   domain="[('parent_id', '=', beneficiary_company_id), ('is_company', '=', False)]"/>
                            <field name="reference"/>
                            <field name="split_method"/>
                            <field name="can_split_cost" invisible="1"/>

                        </group>
                    </group>

                    <notebook>
                        <!-- General Information -->
                        <page string="General Information">
                            <group>
                                <group string="Account &amp; Details">
                                    <field name="acc_name"/>
                                    <field name="bank_account_id" domain="[('bank_id','=',advising_bank_id),]" context="{'default_bank_id': advising_bank_id}"/>
                                    <field name="amount"/>
                                    <field name="currency_id"/>
                                    <field name="currency_rate"/>
                                    <field name="margin_percentage"/>
                                </group>
                                <group string="Important Dates">
                                    <field name="date_of_issue"/>
                                    <field name="expiration_date"/>
                                    <field name="bonded_warehouse_expiry" invisible="lc_type not in ['import', 'standby', 'transferable', 'back_to_back', 'foreign_back_to_back', 'local_back_to_back']"/>
                                    <field name="warning_interval"/>
                                    <field name="reminder_date"/>
                                </group>
                            </group>
                        </page>

                        <!-- Shipment -->
                        <page string="Shipment">
                            <group>
                                <group >
                                    <field name="mode_of_shipment"/>
                                    <field name="partial_shipment"/>
                                </group>
                                <group>
                                    <field name="transshipment"/>
                                    <field name="required_documents"/>
                                </group>
                            </group>
                        </page>

                        <!-- Availability & Charges -->
                        <page string="Availability and Charges">
                            <group>
                                <group>
                                    <field name="available_by"/>
                                </group>
                                <group>
                                    <field name="charges_borne_by"/>
                                </group>
                            </group>
                        </page>

                        <!-- Revolving LC -->
                        <page string="Revolving" invisible="lc_type not in ['revolving'] ">
                            <group>
                                <group>
                                    <field name="parent_lc_id"/>
                                </group>
                                <group>
                                    <field name="revolving_period"/>
                                    <field name="revolving_limit"/>
                                </group>
                            </group>
                        </page>

                        <!-- Insurance -->
                        <page string="Insurance">
                            <group>
                                <group>
                                    <field name="insurance_policy_no"/>
                                </group>
                                <group>
                                    <field name="insurance_company_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Certificates -->
                        <page string="Certificates">
                            <group>
                                <group>
                                    <field name="noc"/>
                                    <field name="bin_certificate"/>
                                </group>
                                <group>
                                    <field name="tax_clearance_certificate"/>
                                    <field name="etin_certificate"/>
                                </group>
                            </group>
                        </page>

                        <!-- Additional Costs -->
                        <page string="Additional Costs">
                            <field name="additional_cost_line_ids">
                                <list editable="bottom">
                                    <field name="additional_cost_id"
                                           domain="[ '|',
                                             ('lc_type', '=', False),
                                             ('lc_type', '=', parent.lc_type)
                                           ]"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="note"/>
                                </list>
                            </field>
                        </page>

                        <!-- Terms & Remarks -->
                        <page string="Terms and Remarks">
                            <group>
                                <group>
                                    <field name="terms_and_conditions"/>
                                </group>
                                <group>
                                    <field name="remarks"/>
                                </group>
                            </group>
                        </page>

                        <!-- Attachments -->
                        <page string="Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>

                        <!--Currency Exchange Rates -->
                        <page string="Currency Exchange Rates" name="currency_rates">
                            <field name="currency_rate_line_ids" nolabel="1">
                                    <list string="Currency Exchange Rate" editable="bottom">
                                        <field name="currency_id"/>
                                        <field name="rate"/>
                                        <field name="amount" sum="Total"/>
                                        <field name="amount_in_target" sum="Total"/>
                                    </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

